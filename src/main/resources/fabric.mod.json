{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}+BTW-${btw_version}",
  "name": "${name}",
  "description": "Search for your ideal Spawn location !",
  "authors": [
    "DraViGen"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/custom-spawn-btw-addon",
    "sources": "https://github.com/BTW-Community/Custom-Spawn"
  },
  "license": "CC-BY-4.0",
  "icon": "assets/custom_spawn/icon.jpg",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.dravigen.custom_spawn.CustomSpawnMod"
    ],
    "btw:addon": [
      "net.dravigen.custom_spawn.CustomSpawnAddon"
    ]
  },
  "custom": {
    "btw:addon_prefix": "EX"
  },
  "mixins": [
    "custom_spawn.mixins.json"
  ],
  "accessWidener" : "CustomSpawn.accessWidener",
  "depends": {
    "fabricloader": ">=0.14.19",
    "minecraft": "1.6.4",
    "btw": ">=${btw_version}"
  }
}
